    "cn": "^0.3.3",
    "cross-spawn": "7.0.6",
    "diff": "9.0.0",
    "dotenv": "^17.4.1",
    "electron-updater": "^6.8.9",
    "jotai": "^2.19.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^0.462.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-core-commonmark": "2.0.4",
    "micromark-extension-gfm": "3.0.0",
