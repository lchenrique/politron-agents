{
  "name": "boobot-desktop",
  "version": "0.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "set ELECTRON_RUN_AS_NODE=&& electron-vite dev",
    "build": "set ELECTRON_RUN_AS_NODE=&& electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hosts:electron": "node scripts/verify-hosts-electron.cjs",
    "test:codex": "set POLITRON_RUN_CODEX_INTEGRATION=1&& vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/renderer/tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "quality:rules": "node scripts/verify-quality-rules.mjs ./eslint-rules/index.cjs",
    "lint:typed": "eslint -c eslint.typed.config.mjs \"src/**/*.{ts,tsx}\"",
    "test:models": "vitest run src/main/v9/providers/detect.test.ts src/main/v9/model-catalog.test.ts src/renderer/src/features/app/SettingsPage.test.tsx",
    "test:voice": "vitest run src/main/v9/voice src/main/v9/realtime src/main/v9/openrouter-voice src/main/v9/pit-voices",
    "test:performance": "set POLITRON_RUN_PERFORMANCE=1&& vitest run src/main/v9/snapshot.performance.test.ts",
    "verify": "npm run quality:rules && npm run lint && npm run lint:typed && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@electron-toolkit/utils": "^3.0.0",
    "@getpaseo/relay": "^0.12.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@monaco-editor/react": "^4.7.0",
    "@pierre/diffs": "^1.1.7",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "dotenv": "^17.4.1",
    "jotai": "^2.19.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^0.462.0",
    "monaco-editor": "^0.57.0",
    "motion": "^12.38.0",
    "next-themes": "^0.3.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.58.2",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "react-router-dom": "^6.30.1",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "^1.13.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "electron": "^40.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@swc/core@1.16.18": true,
    "electron@40.10.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true
  },
  "description": "Boobot — aplicativo open source de agentes de IA e equipes de Boos"
}
